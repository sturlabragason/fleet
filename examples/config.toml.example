# fleet local preferences — EXAMPLE
#
# Copy to ~/.config/fleet/config.toml (or $XDG_CONFIG_HOME/fleet/config.toml,
# or point $FLEET_CONFIG at it). The real file lives outside the repo and is
# never committed: it holds your opinionated defaults, not the project's.
#
# Everything here is optional. With no file at all, fleet spawns agents in
# whatever mode the tool itself defaults to.

[defaults]
# TUI colour palette (ADR-55): "catppuccin" (the default), "stealth",
# "neon-drive", "phosphor" or "graphite". An unknown name stops fleet rather
# than falling back silently. Resolved at start-up: change it and run
# `fleet up` again — the tmux chrome is re-set and the overview pane restarts,
# agents keep running.
# theme = "catppuccin"
# Tool profile for fleet_spawn and fleet_squad_spawn calls that name none
# (see `fleet profiles`). Unset: every spawn call must name a profile.
# Re-read on every spawn. The spawn reply always names the profile and model.
# profile = "claude-copilot"
# Starting mode, looked up in the profile's mode_args / mode_keys.
# "" (or omitted) leaves the tool alone. An unknown mode is logged and ignored.
# "auto" is defined by every built-in profile and means "run every tool call
# without asking", in that tool's own words: Copilot --allow-all --autopilot,
# Claude Code --permission-mode bypassPermissions, agy
# --dangerously-skip-permissions, vibe --auto-approve (ADR-56).
# WARNING: with mode = "auto" every agent runs every command unattended.
mode = ""
# Press Enter after a pasted first prompt. Setting this to false also turns off
# launch-time delivery (`copilot -i <prompt>` submits the prompt itself), so the
# prompt is pasted into the input box and left there for you.
auto_submit = true
# How long to wait for the tool's TUI to start accepting input before pasting
# anyway. Spawn polls the pane rather than sleeping a fixed amount. Spawn blocks
# for up to this long, including the fleet_spawn MCP call, so keep it modest.
ready_timeout = "15s"
# Close an agent when it reports done (fleet_report) and left no work of its
# own: no new or changed uncommitted files since spawn, no new worktree, no
# commits unmerged into main/master. Dirs outside git close. Never removes the
# worktree or branch.
# auto_close_done = false
# With auto_close_done: also close a done agent idle this long once the check
# passes (e.g. after the admiral merged its branch). Off when unset.
# auto_close_idle = "15m"
# An agent whose process exits cleanly (/exit) closes at once. One that crashes
# (non-zero exit or a signal) is reported to the admiral and closed after this
# long: "0" closes at once, "off" never. Its dir and session stay on disk.
# dead_pane_grace = "5m"
# An agent counts as stuck when the same error banner shows twice in a row, or
# when it is working and its screen has not changed for this long. A stuck
# agent goes red and the admiral is told once; nothing is paused or killed.
# "off" (or "0") turns off the no-progress half; the same-error half stays on.
# stuck_after = "10m"
# What else to do with a stuck agent: "none" (the default, just tell the
# admiral) or "interrupt", which also sends one Escape to its pane.
# stuck_action = "none"
# playbook = true  # prepend the fleet worker playbook to the first prompt (DESIGN §4)
# Give each agent spawned into a git repo its own worktree, <repo>.wt/<name> on
# branch fleet/<name>, and run it there instead of in your checkout, so parallel
# agents don't fight over one index (DESIGN §4, ADR-40). `fleet spawn
# --no-worktree` (or worktree=false on fleet_spawn) skips it for one spawn.
# Closing an agent never removes the worktree or the branch.
# worktree = true
# How fleet runs an agent: "tmux" (the tool's own screen) or "acp" (the tool's
# ACP server under fleet acp-host; copilot, claude-copilot, agy, claude and fake).
# Unset, every profile that runs copilot or agy (claude-copilot too) uses acp
# and the rest tmux (since v1.0.0; ADR-74 (i)). "tmux" here
# restores the v0 behaviour for every profile; per profile under
# [profile.<name>]. `fleet spawn --driver` wins (ADR-74). Claude is opt-in:
# [defaults] never moves it to acp, only [profile.<name>] or --driver does
# (ADR-76).
# driver = "tmux"
# [profile.claude-personal]
# driver = "acp"
# Before an agent starts, write its dir into the tool's own trust store so it
# never stops on "Do you trust this folder?" (Claude's ~/.claude.json or the
# profile's CLAUDE_CONFIG_DIR, Copilot's trustedFolders, vibe's
# trusted_folders.toml), and answer the dialog on screen for a tool fleet
# cannot pre-mark, like agy. false: you get the prompt (DESIGN §4, ADR-47).
# auto_trust = true
# A Claude agent in a fleet worktree gets blockWritesOutsideWorkingDirectories
# in its --settings, with <repo>.wt/ as the one extra dir: its file tools
# cannot write the main checkout, home or other repos. Shell, MCP and hooks
# are not covered. false: no fence (ADR-79).
# fence_writes = true
# Workers start without your global MCP servers (Copilot's
# ~/.copilot/mcp-config.json, Claude's ~/.claude.json): their tools would be
# sent with every call. Name the ones a worker should keep (ADR-91).
# keep_mcp = ["github"]
# Added to every agent pane's environment (spawn and adopt), over the profile's
# own env. [profile.<name>] env keys override these one by one. Keeps parallel
# builds and tests from each taking every core (DESIGN §7a, docs/perf.md).
# PATH is reserved: fleet sets it (~/.local/bin + your PATH) and ignores it here.
# env = { GOFLAGS = "-p=4", GOMAXPROCS = "4" }
# At most this many agents work at once; further spawns queue and the overview
# TUI starts them as slots free. 0 = no cap. Fleet-wide, [defaults] only.
# Re-read on every use: change it and a running fleet picks it up (DESIGN §7).
# max_working = 4
# Which agents may message each other without asking (DESIGN §6.6, ADR-34).
# "team": the same team, or the same repo (any worktree) when neither has a team.
#         Other pairs ask, and you or the target agent decide. Teams can be
#         different clients or private projects; this keeps messages inside one.
# "open": every agent may message every other.
# "ask":  every pair asks first, teammates too.
# Every message is logged (`fleet access log`), and `fleet access revoke A B`
# still stops any pair. Fleet-wide, [defaults] only; takes effect at once.
# agent_mail = "team"
# Tell an agent's owner (admiral or squad leader), once per agent, to hand its
# work to a fresh agent after this many context compactions or this many AI
# credits (Copilot agents; DESIGN §7b, ADR-71). Agents that compacted cost
# about ten times as much. 0 turns a threshold off. [defaults] only.
# recycle_compactions = 2
# recycle_aic = 1000

# The cheap model behind `fleet peek --summary` and MCP fleet_peek summary=true
# (DESIGN §6.2, ADR-40). It shells out to a CLI you already have signed in, so
# fleet never holds an API key. Defaults: Copilot CLI, Haiku 5.5, one call per
# agent per 30s, 45s timeout. About 6k input tokens and 5s per call: the
# default args strip the CLI's instructions and tools, which is most of that. Summaries are only ever made on request, cached
# under the hash of the screen they came from, and fail open.
# [summary]
# enabled = true
# model = "claude-haiku-5.5"
# command = "copilot"
# {prompt} and {model} are replaced; without {prompt} the prompt goes on stdin,
# so `claude` works too: command = "claude", args = ["-p", "{prompt}", "--model", "{model}"]
# args = ["-p", "{prompt}", "--model", "{model}", "--silent", "--no-custom-instructions", "--available-tools", "none", "--disable-builtin-mcps", "--log-level", "none", "--no-color"]
# min_interval = "30s"   # at most one model call per agent per interval ("0" = no limit)
# timeout = "45s"

[profile.copilot]
# WARNING: "autopilot" for Copilot launches `--allow-all --autopilot`.
# The agent then runs every tool call without asking. Opt in deliberately.
# (`--autopilot` on its own opens a blocking permission dialog, which is why
# --allow-all is part of the mode.)
mode = "autopilot"
extra_args = ["--reasoning-effort", "high"]

[profile.claude]
# "accept-edits", "plan" or "bypass" -> claude --permission-mode ...
mode = "accept-edits"

# A [profile.<name>] section is also a third override layer for tool profiles,
# after the built-ins and ~/.fleet/tools.toml. It accepts every tools.toml key,
# so you can define a new profile without touching the repo.
# A section that neither names an existing profile nor sets `command` is ignored
# with a warning — a typo like [profile.coplot] cannot create a dead profile.
[profile.my-copilot]
command = "copilot"
args = ["--model", "claude-opus-5"]
patterns = "copilot"
mode = "autopilot"
# mode_args / mode_keys are inline tables of SPACE-SEPARATED strings, not of
# arrays: fleet's TOML subset types an inline table as string -> string and
# splits each value on whitespace. Limitation: an argument that itself contains
# a space cannot be written this way; put it in `args` or `extra_args`.
mode_args = { autopilot = "--allow-all --autopilot", plan = "--plan" }
# context_args has the same shape, keyed by effort level (light, standard,
# pro, leader), and is added at spawn and wake (ADR-60). The built-in Copilot
# profiles exclude built-in tools fleet agents don't use; setting it here
# replaces that whole table, e.g. to also drop skills for light agents:
# context_args = { light = "--excluded-tools sql session_store_sql task skill --disable-builtin-mcps" }

# The RAM guard (DESIGN §7, ADR-44). When free memory (MemAvailable) falls
# under min_free, fleet parks the longest-idle agent -- never a pinned,
# working, waiting or prompted one -- at most one per check_every, tells the
# admiral, and queues new spawns until memory comes back. Reversible:
# `fleet wake <name>` resumes a parked agent where it stopped.
# These keys are re-read on every use, so a running fleet retunes at once.
[memory]
# guard = false          # switch the guard off entirely (default: on)
# min_free = "4GB"       # park below this much free memory (B/KB/MB/GB/TB)
# check_every = "30s"    # at most one park per interval, across all processes

# The admiral's tool profile when nothing else picks one (DESIGN §6.10).
# Order: fleet --admiral-profile > $FLEET_ADMIRAL_PROFILE > last choice
# (Alt-P / fleet admiral profile NAME) > this > copilot.
# [admiral]
# profile = "claude-personal"
# max = 3                # admirals on one fleet, main included; at most 3 (DESIGN §6.12)

# How big a squad a leader may run, and how deep the hierarchy goes
# (DESIGN §6.11). max_depth = 1 means a leader's own agents cannot lead.
# 0 means no limit. Read live: a change applies without restarting fleet.
# [squad]
# max_members = 4
# max_depth = 1
