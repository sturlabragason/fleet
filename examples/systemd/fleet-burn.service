# fleet quota burn tick (ADR-190, docs/burn.md).
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp examples/systemd/fleet-burn.service examples/systemd/fleet-burn.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fleet-burn.timer
# Undo:
#   systemctl --user disable --now fleet-burn.timer
#   rm ~/.config/systemd/user/fleet-burn.{service,timer} && systemctl --user daemon-reload

[Unit]
Description=fleet quota burn tick
After=network-online.target

[Service]
Type=oneshot
# The repo a +burn task without a dir field runs in. Edit before install;
# a dir that is not a git repo makes those spawns fail (burn needs a branch).
WorkingDirectory=%h/src/your-repo
# User units get a minimal PATH; task, agy and ai-usagebar usually live here.
Environment=PATH=%h/.local/bin:%h/go/bin:%h/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/fleet burn --tick
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
